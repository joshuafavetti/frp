# Copy to .env and set a strong value: openssl rand -hex 32
FRP_TOKEN=

# --- Optional: Nginx Proxy Manager integration ---
# Uncomment both to join frps to NPM's existing Docker network.
# PROXY_NETWORK is that network's name (e.g. "proxy" or "npm_default").
# COMPOSE_FILE=compose.yaml:compose.npm.yaml
# PROXY_NETWORK=proxy
