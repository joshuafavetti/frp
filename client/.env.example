# Copy to .env and fill in.

# Public DNS name of the frp server; must match a name in its certificate.
FRP_SERVER_ADDR=frp.example.com

# Same value as FRP_TOKEN in the server's .env.
FRP_TOKEN=

# Shared secret for stcp proxies/visitors: openssl rand -hex 32
# The client exposing a service and the visitor connecting to it must match.
FRP_STCP_SECRET=
